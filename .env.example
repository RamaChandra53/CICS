# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Verification & Delivery
# OPTION 1 (Easiest & Recommended for free direct delivery to @mgit.ac.in):
# Use any Gmail account with a 16-character App Password (myaccount.google.com/apppasswords)
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional SMTP overrides (defaults to Gmail 465 SSL):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# EMAIL_FROM="CICS MGIT" <youraccount@gmail.com>

# OPTION 2 (Resend API):
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM="CICS" <verify@yourdomain.com>
